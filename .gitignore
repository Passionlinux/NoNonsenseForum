# ignore files that aren't part of NoNonsenseForum:
# (in this folder we want to ignore the site's data -- RSS feeds, subforums and configuration)
*
!.gitignore
!.gitattributes

# server
!.htaccess
!robots.txt
!favicon.default.ico
!apple-touch-icon.default.png
!metro-tile.default.png

# code
!config.default.php
!index.php
!start.php
!thread.php
!markup.php
!privacy.php
!lib/
!themes/
!users/

# development & continuous integration
# (`vendor/` is intentionally *not* listed: composer's dependencies are not part of the forum)
!composer.json
!composer.lock
!phpstan.neon
!phpunit.xml.dist
!tests/
!tests/**
!.github/
!.github/**

# documentation
!HISTORY.txt
!INSTALL.txt
!LICENCE.txt
!README.txt